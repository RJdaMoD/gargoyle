++static void rule_find_strip_protocol_dependency(char *rule)
++{
++	static const char *const dependency[] = {
++		"meta protocol ",
++		"meta nfproto ",
++		"meta l4proto ",
++		"ether type ",
++		"ip protocol ",
++		"ip6 nexthdr ",
++	};
++	unsigned int i;
++
++	for (;;) {
++		bool matched = false;
++
++		for (i = 0; i < array_size(dependency); i++) {
++			char *match, *value, *end;
++
++			match = strstr(rule, dependency[i]);
++			if (!match)
++				continue;
++			value = match + strlen(dependency[i]);
++			end = strchr(value, ' ');
++			if (end) {
++				memmove(match, end + 1, strlen(end + 1) + 1);
++				matched = true;
++			}
++			break;
++		}
++		if (!matched)
++			break;
++	}
++}
++
++static void rule_find_normalize_counter(char *rule)
++{
++	const char *counter = "counter";
++	const char *packets = " packets ";
++	const char *bytes = " bytes ";
++	char *match, *p, *end;
++
++	for (p = rule; (match = strstr(p, counter)) != NULL; p = match + 1) {
++		unsigned long long value;
++
++		if (match != rule && match[-1] != ' ')
++			continue;
++		p = match + strlen(counter);
++		if (strncmp(p, packets, strlen(packets)))
++			continue;
++		value = strtoull(p + strlen(packets), &end, 10);
++		(void)value;
++		if (end == p + strlen(packets) ||
++		    strncmp(end, bytes, strlen(bytes)))
++			continue;
++		value = strtoull(end + strlen(bytes), &p, 10);
++		(void)value;
++		if (p == end + strlen(bytes))
++			continue;
++
++		/* Keep the counter statement, but discard its live values. */
++		memmove(match + strlen(counter), p, strlen(p) + 1);
++	}
++}
