++/* Keep command-line rule output consistent with rules read back from the
++ * kernel.  The kernel represents an address mask as a prefix; parser rules
++ * still contain the equivalent bitwise expression at print time. */
++static bool expr_mask_is_prefix(const struct expr *expr)
++{
++	unsigned long n1, n2;
++
++	n1 = mpz_scan1(expr->value, 0);
++	if (n1 == ULONG_MAX)
++		return true;
++	n2 = mpz_scan0(expr->value, n1 + 1);
++	if (n2 < expr->len || n2 == ULONG_MAX)
++		return false;
++	return true;
++}
++
++static unsigned int expr_mask_to_prefix(const struct expr *expr)
++{
++	unsigned long n;
++
++	n = mpz_scan1(expr->value, 0);
++	if (n == ULONG_MAX)
++		return 0;
++	if (mpz_scan0(expr->value, n + 1) == ULONG_MAX)
++		return expr->len - n;
++	return mpz_scan0(expr->value, n + 1) - n;
++}
++
++void nft_optimize_rule_prefix(struct rule *rule)
++{
++	struct stmt *stmt;
++	struct expr *expr, *binop, *right, *prefix;
++
++	list_for_each_entry(stmt, &rule->stmts, list) {
++		if (stmt->ops->type != STMT_EXPRESSION)
++			continue;
++
++		expr = stmt->expr;
++		if (expr->etype != EXPR_RELATIONAL ||
++		    (expr->op != OP_EQ && expr->op != OP_NEQ) ||
++		    expr->left->etype != EXPR_BINOP ||
++		    expr->left->op != OP_AND ||
++		    expr->left->left->etype != EXPR_PAYLOAD ||
++		    expr->left->right->etype != EXPR_VALUE ||
++		    expr->right->etype != EXPR_VALUE ||
++		    !datatype_prefix_notation(expr->left->left->dtype) ||
++		    !expr_mask_is_prefix(expr->left->right))
++			continue;
++
++		binop = expr->left;
++		right = expr->right;
++		prefix = prefix_expr_alloc(&expr->location, expr_get(right),
++					  expr_mask_to_prefix(binop->right));
++		/* prefix_expr_alloc() intentionally starts with invalid type
++		 * information.  The normal evaluator fills these fields in before
++		 * linearization; do the same here because this rule is still sent to
++		 * the kernel after check-mode output is produced. */
++		prefix->dtype = right->dtype;
++		prefix->byteorder = right->byteorder;
++		prefix->len = right->len;
++		prefix->flags |= EXPR_F_CONSTANT;
++		expr->left = expr_get(binop->left);
++		expr->right = prefix;
++		expr_free(binop);
++		expr_free(right);
++	}
++}
